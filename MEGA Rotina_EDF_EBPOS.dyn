{
  "Uuid": "d87d6db9-a6f7-498c-b225-d72e497108c8",
  "IsCustomNode": false,
  "Description": "",
  "Name": "MEGA Rotina_EDF_EBPOS",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import traceback\r\n\r\ntry:\r\n    import clr\r\n    clr.AddReference('RevitAPI')\r\n    from Autodesk.Revit.DB import *\r\n    from Autodesk.Revit.DB.Structure import StructuralType\r\n\r\n    clr.AddReference('RevitServices')\r\n    import RevitServices\r\n    from RevitServices.Persistence import DocumentManager\r\n    from RevitServices.Transactions import TransactionManager\r\n\r\n    doc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n    # Função antiduplicidade\r\n    def obter_elementos_unicos(dados):\r\n        elementos, ids_vistos = [], set()\r\n        def extrair(item):\r\n            if isinstance(item, list):\r\n                for i in item: extrair(i)\r\n            else:\r\n                elem = UnwrapElement(item)\r\n                if elem and hasattr(elem, \"Id\"):\r\n                    id_val = elem.Id.IntegerValue\r\n                    if id_val not in ids_vistos:\r\n                        ids_vistos.add(id_val)\r\n                        elementos.append(elem)\r\n        extrair(dados)\r\n        return elementos\r\n\r\n    elementos = obter_elementos_unicos(IN[0])\r\n    \r\n    # Mapeamento das 5 famílias\r\n    fam_reto_alta = UnwrapElement(IN[1])\r\n    fam_ed1_alta = UnwrapElement(IN[2])\r\n    fam_redutor = UnwrapElement(IN[3])\r\n    fam_reto_baixa = UnwrapElement(IN[4])\r\n    fam_ed1_baixa = UnwrapElement(IN[5])\r\n    \r\n    NOME_PARAMETRO = \"Comprimento\"\r\n\r\n    TransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n    # Ativa todas as famílias para evitar erros\r\n    for fam in [fam_reto_alta, fam_ed1_alta, fam_redutor, fam_reto_baixa, fam_ed1_baixa]:\r\n        if fam and not fam.IsActive:\r\n            fam.Activate()\r\n\r\n    sucessos = 0\r\n    relatorio = []\r\n\r\n    for elem in elementos:\r\n        if not hasattr(elem, \"Location\") or not hasattr(elem.Location, \"Curve\"):\r\n            continue\r\n\r\n        # 1. LEITURA INTELIGENTE DO NÍVEL\r\n        try:\r\n            nivel_id = elem.ReferenceLevel.Id if hasattr(elem, \"ReferenceLevel\") else elem.LevelId\r\n            nivel = doc.GetElement(nivel_id)\r\n            nome_nivel = nivel.Name.upper() if nivel else \"DESCONHECIDO\"\r\n        except:\r\n            nome_nivel = \"DESCONHECIDO\"\r\n\r\n        # 2. SEPARADOR DE ALTA E BAIXA CORRENTE\r\n        # A regra verifica se o andar está a jusante do redutor (Acima do 5º Pavimento)\r\n        andares_baixa = [\"6º\", \"7º\", \"8º\", \"9º\", \"ÁTICO\", \"COBERTURA\", \"BARRILETE\", \"RESERVATÓRIO\"]\r\n        is_baixa = any(andar in nome_nivel for andar in andares_baixa)\r\n\r\n        # 3. O FILTRO DAS REGRAS (Cardápio Avançado)\r\n        if \"5º\" in nome_nivel:\r\n            fam_escolhida = fam_redutor\r\n            tipo_nome = \"REDUTOR (1000A -> 800A)\"\r\n            \r\n        elif \"TÉRREO\" in nome_nivel or \"3º\" in nome_nivel or \"7º\" in nome_nivel or \"ÁTICO\" in nome_nivel:\r\n            if is_baixa or \"7º\" in nome_nivel or \"ÁTICO\" in nome_nivel:\r\n                fam_escolhida = fam_ed1_baixa\r\n                tipo_nome = \"DERIVAÇÃO (ED1) - 800A\"\r\n            else:\r\n                fam_escolhida = fam_ed1_alta\r\n                tipo_nome = \"DERIVAÇÃO (ED1) - 1000A\"\r\n                \r\n        else:\r\n            if is_baixa:\r\n                fam_escolhida = fam_reto_baixa\r\n                tipo_nome = \"RETO/FECHAMENTO - 800A\"\r\n            else:\r\n                fam_escolhida = fam_reto_alta\r\n                tipo_nome = \"RETO/FECHAMENTO - 1000A\"\r\n\r\n        # 4. EXTRAÇÃO GEOMÉTRICA\r\n        curva = elem.Location.Curve\r\n        ponto_medio = curva.Evaluate(0.5, True)\r\n        ponto_inicial = curva.GetEndPoint(0)\r\n        ponto_final = curva.GetEndPoint(1)\r\n        tamanho_exato = curva.Length\r\n        \r\n        # 5. INSERÇÃO E ROTAÇÃO\r\n        novo_barramento = doc.Create.NewFamilyInstance(ponto_medio, fam_escolhida, StructuralType.NonStructural)\r\n        doc.Regenerate()\r\n        \r\n        param_tamanho = novo_barramento.LookupParameter(NOME_PARAMETRO)\r\n        if param_tamanho:\r\n            param_tamanho.Set(tamanho_exato)\r\n        \r\n        direcao = (ponto_final - ponto_inicial).Normalize()\r\n        angulo = XYZ.BasisX.AngleOnPlaneTo(direcao, XYZ.BasisZ)\r\n        \r\n        if angulo != 0:\r\n            eixo_z_rot = Line.CreateBound(ponto_medio, ponto_medio + XYZ.BasisZ)\r\n            ElementTransformUtils.RotateElement(doc, novo_barramento.Id, eixo_z_rot, angulo)\r\n        \r\n        # Apaga a eletrocalha nativa\r\n        doc.Delete(elem.Id)\r\n        \r\n        sucessos += 1\r\n        relatorio.append(\"Andar: \" + nome_nivel + \" -> Inserido: \" + tipo_nome)\r\n\r\n    TransactionManager.Instance.TransactionTaskDone()\r\n\r\n    OUT = \"SUCESSO! \" + str(sucessos) + \" peças modeladas e calculadas.\\n\\nRESUMO DA PRUMADA:\\n\" + \"\\n\".join(relatorio)\r\n\r\nexcept Exception as erro:\r\n    OUT = \"ERRO FATAL:\\n\" + traceback.format_exc()",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "a7ecebeafc71451c8e3a6ba8dc46c3ed",
