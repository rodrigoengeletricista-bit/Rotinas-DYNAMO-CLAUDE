  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Mapeamento Nível (Revit) -> Peça a inserir no trecho ACIMA do nível\r\n# Nomes de Family Type confirmados: \"Barramento-Reto\", \"Barramento-Derivação-1 Plugue\",\r\n# \"Barramento-Redução-1250A-1000A\"\r\n\r\nMAPA_NIVEIS = {\r\n    \"(-1)NO-SUBSOLO-ELT\": {\r\n        \"peca\": \"INICIO\",          # apenas ponto de partida, sai do QGBT\r\n        \"cm\": None\r\n    },\r\n    \"00NA-TÉRREO-ELT\": {\r\n        \"peca\": \"Barramento-Derivação-1 Plugue\",\r\n        \"cm\": \"CM_TERREO\"\r\n    },\r\n    \"01NA-2º PAVIMENTO - TIPO-ELT\": {\r\n        \"peca\": \"Barramento-Reto\",\r\n        \"cm\": None\r\n    },\r\n    \"02NA-3º PAVIMENTO - TIPO-ELT\": {\r\n        \"peca\": \"Barramento-Derivação-1 Plugue\",\r\n        \"cm\": \"CM_APTOS_TIPO\"\r\n    },\r\n    \"03NA-4º PAVIMENTO - TIPO-ELT\": {\r\n        \"peca\": \"Barramento-Reto\",\r\n        \"cm\": None\r\n    },\r\n    \"04NA-5º PAVIMENTO - DUPLEX INFERIOR-ELT\": {\r\n        \"peca\": \"Barramento-Redução-1250A-1000A\",   # + derivação no mesmo trecho\r\n        \"cm\": \"CM_DUPLEX\",\r\n        \"peca_extra\": \"Barramento-Derivação-1 Plugue\"\r\n    },\r\n    \"05NA-6º PAVIMENTO - DUPLEX SUPERIOR-ELT\": {\r\n        \"peca\": \"Barramento-Reto\",\r\n        \"cm\": None\r\n    },\r\n    \"06NA-ÁTICO-ELT\": {\r\n        \"peca\": \"Barramento-Derivação-1 Plugue\",\r\n        \"cm\": \"CM_CONDOMINIO_ATICO\"\r\n    },\r\n}",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "5422e9b621c448f180ea5750d3055f56",
      "NodeType": "PythonScriptNode",
      "Inputs": [
